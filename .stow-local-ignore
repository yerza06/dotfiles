# Этот файл заменяет стандартный список игнора stow,
# поэтому дефолты (из Stow.pm) повторены здесь.

RCS
.+,v

CVS
\.\#.+       # CVS conflict files / emacs lock files
\.cvsignore

\.svn
_darcs
\.hg

\.git
\.gitignore
\.gitmodules

.+~          # emacs backup files
\#.*\#       # emacs autosave files

^/README.*
^/LICENSE.*
^/COPYING

# Свои исключения
^/\.stow-local-ignore
^/pyinfra

