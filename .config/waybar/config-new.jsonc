// -*- mode: jsonc -*-
{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "modules-left": [
        "custom/logo",
        "niri/workspaces",
        "custom/drive_line_left",
        "mpris"
    ],
    "modules-center": [
        "clock"
	],
    "modules-right": [
        "tray",
        "niri/language",
        "pulseaudio",
        "group/drive",
        "group/connection",
        "power-profiles-daemon",
        "battery"
    ],
    "group/drive": {
        "orientation": "horizontal",
        "modules": [
            "custom/drive_line",
            "user",
            "backlight",
            "cpu",
            "memory",
            "disk",
            "temperature"
        ],
        "drawer": {
            "transition-duration": 250,
            "children-class": "drawer-child",
            "transition-left-to-right": false
        }
    },
    "group/connection": {
        "orientation": "inherit",
        "modules": [
            "network",
            "bluetooth"
        ]
    },
	"user": {
		"format": " {work_H}:{work_M}:{work_S}",
		"interval": 1,
        "open-on-click": false
	},
     "niri/workspaces": {
         "format": " {} ",
         "format-icons": {
             "urgent": "",
             "default": "󰧞",
             "active": "󰮯",
         }
     },
     "mpris": {
         "format": "{status_icon} {title}",
         "tooltip-format": " Artist\t{artist}\n󰀥 Album\t{album}\n{player_icon} Title\t{title}",
         "player-icons": {
             "default": "",
             "mpv": "󰎇",
             "spotify": "",
             "chromium": "",
             "firefox": "󰈹",
             "vlc": "󰕼",
             "TelegramDesktop": ""
         },
         "dynamic-order": ["title", "artist"],
         "status-icons": {
             "playing": "󰐊",
             "paused": "󰏤",
         },
         "max-length": 50
     },
    "tray": {
        "spacing": 10
    },
    "clock": {
		"format": "{:%Y-%m-%d %H:%M:%S}",
		"interval": 1,
		"max-length": 30,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
		"format-alt": "{:%H:%M:%S}",
    },
    "cpu": {
        "interval": 1,
        "format": " {usage}%" ,
        "tooltip": "{load}"
    },
    "memory": {
        "interval": 1,
        "format": " {}%"
    },
    "temperature": {
        "interval": 1,
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C" ,
        "format-icons": ["", "", ""]
    },
    "disk": {
        // "interval": 5,
        "format": "󰋊 {percentage_used}%",
        "path": "/",
        "tooltip-format": "Used: {percentage_used}% | {used}\nFree: {percentage_free}% | {free}"
    },
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "tooltip-format": "Display: {percent}%"
    },
	"niri/language": {
		"format": "󰌌 {}",
        "format-en": "US",
        "format-ru": "RU",
        "format-kk": "KZ",
        "on-click": "niri msg action switch-layout next",
        "on-click-right": "niri msg action switch-layout prev",
        "tooltip-format": "{long}"
	},
    "battery": {
		"interval": 20,
        "format": "{capacity}% {icon}",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        },
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "{icon} {profile}",
      "tooltip": true,
      "format-icons": {
        "performance": "",
        "balanced": "",
        "power-saver": ""

      }
    },
    "network": {
        "format-wifi": "",
		"format-ethernet": "",
        "tooltip-format": "SSID: {essid} ({signalStrength}%)\nGateway: {gwaddr}\nIP: {ipaddr}",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected  ",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
		"on-click": "kitty nmtui",
		"on-click-middle": "bash ~/.config/waybar/scripts/wifiscript.sh toggle",
    },
    "bluetooth": {
	"format-on": " {status}",
	"format-off": "󰂲 {status}",
	"format-disabled": "sss", // an empty format will hide the module
	"format-connected": " {num_connections}",
	"tooltip-format": "{controller_alias}\t{controller_address}",
	"tooltip-format-connected": "󰥈{device_battery_percentage} | {controller_alias}\t{controller_address}\n\n{device_enumerate}",
	"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "kitty bluetui",
    "on-click-middle": "bash ~/.config/waybar/scripts/bluescript.sh toggle",
},
    "pulseaudio": {
        "scroll-step": 1, // %, can be a float
        "format": "{icon} {volume}% {format_source}",
        "format-muted": "<span color=\"#D14D41\"> </span>{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": "<span color=\"#D14D41\"></span>",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "kitty pulsemixer",
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click-right": "pavucontrol",
        "tooltip": true,
        "tooltip-format": "Output: {desc}"
    },
    "custom/logo": {
        "format": "",
        "on-click": "bash ~/.local/bin/toggle-theme-script.sh",
        "on-click-right": "systemctl --user restart waybar.service",
    },
    "custom/drive_line_right": {
        "format": "",
    },
    "custom/drive_line_left": {
        "format": "",
    }

}
