// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    {
        "context": "Workspace",
        "bindings": {
            "ctrl-shift-t": "terminal_panel::Toggle",
            "ctrl-alt-t": "task::Spawn",
            "alt-g j": "git::Pull",
            "alt-g k": "git::Push",
            "alt-g up": "git::Push",
            "alt-g down": "git::Pull",
            "alt-g s": "git::Switch",
            "alt-g d": "git::Diff",
        },
    },
    {
        "context": "ProjectPanel && vim_mode == normal",
        "bindings": {
            "a": "project_panel::NewFile",
            "r": "project_panel::Rename",
            "A": "project_panel::NewDirectory",
            "d": "project_panel::Delete",
            "y": "project_panel::Copy",
        },
    },
    {
        "context": "vim_mode == insert",
        "bindings": {
            "ctrl-n": "menu::SelectNext",
            "ctrl-p": "menu::SelectPrevious",
        },
    },
    {
        "context": "Editor && vim_mode == visual",
        "bindings": {
            "ctrl-c": ["workspace::SendKeystrokes", "\" + y"],
            "ctrl-v": ["workspace::SendKeystrokes", "\" + p"],
            "Y": ["workspace::SendKeystrokes", "\" + y"],
            "P": ["workspace::SendKeystrokes", "\" + p"],
        },
    },
    {
        "context": "Editor && vim_mode == normal",
        "bindings": {
            "ctrl-j": "workspace::ToggleBottomDock",
            "ctrl-b": "workspace::ToggleLeftDock",
            "ctrl-alt-b": "workspace::ToggleRightDock",
            "ctrl-shift-t": "terminal_panel::Toggle",
            "shift-l": "pane::ActivateNextItem",
            "shift-h": "pane::ActivatePreviousItem",
            "alt-j": "editor::MoveLineDown",
            "alt-k": "editor::MoveLineUp",
            "ctrl-t p": ["task::Spawn", { "task_name": "r/python/main" }],
            "ctrl-shift-l": "workspace::ActivatePaneRight",
            "ctrl-shift-h": "workspace::ActivatePaneLeft",
            "ctrl-shift-j": "workspace::ActivatePaneDown",
            "ctrl-shift-k": "workspace::ActivatePaneUp",
            "space -": "pane::SplitVertical",
            "space =": "pane::SplitHorizontal",
            "space q": "pane::CloseActiveItem",
            "Y": ["workspace::SendKeystrokes", "\" + y enter"],
            "P": ["workspace::SendKeystrokes", "\" + p enter"],
        },
    },
    {
        "context": "Terminal",
        "bindings": {
            "ctrl-alt-n": "pane::ActivateNextItem",
            "ctrl-alt-p": "pane::ActivatePreviousItem",
            "ctrl-n": "workspace::NewTerminal",
            "ctrl-shift-l": "workspace::ActivatePaneRight",
            "ctrl-shift-h": "workspace::ActivatePaneLeft",
            "ctrl-shift-j": "workspace::ActivatePaneDown",
            "ctrl-shift-k": "workspace::ActivatePaneUp",
            "ctrl-w q": "pane::CloseActiveItem",
            "ctrl-w =": "pane::SplitVertical",
            "ctrl-w -": "pane::SplitHorizontal",
        },
    },
    {
        "bindings": {
            "f8": "debugger::FocusTerminal",
        },
    },
    {
        "bindings": {
            "ctrl-alt-g": "git_graph::Open",
        },
    },
]
