// includes/window-rules.kdl

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
    default-column-width { fixed 890; }
}

window-rule {
    match app-id="kitty"
    match app-id="Alacritty"

    background-effect {
        blur true
    }
}

window-rule {
    match app-id="dev.zed.Zed"
    match app-id="obsidian"

    background-effect {
        blur true
    }
}

window-rule {
    match app-id="firefox"
    match app-id="zen-browser"
    match app-id="Claude"
    match app-id="obsidian"
    match app-id="org.telegram.desktop"


    open-maximized true
}

window-rule {
    match app-id="Bitwarden"

    block-out-from "screencast"
}

window-rule {
    match app-id="org.gnome.Nautilus"
    match app-id="org.gnome.Calculator"
    match app-id="io.github.redddfoxxyy.samaya"
    match app-id="thunar"
    match title="Nautilus"
    open-floating true
    default-column-width { fixed 1300; }
    default-window-height { fixed 850; }
}

