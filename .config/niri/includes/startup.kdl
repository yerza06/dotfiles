// includes/startup.kdl

// spawn-at-startup "waybar"
// spawn-at-startup "xwayland-satellite"

// To run a shell command (with variables, pipes, etc.), use spawn-sh-at-startup:
// spawn-sh-at-startup "qs -c ~/source/qs/MyAwesomeShell"
spawn-sh-at-startup "wl-paste --type text --watch cliphist store &"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store &"
// Status bar is managed by quickshell_status_bars.service.
// spawn-sh-at-startup "qs -p ~/.config/quickshell/status_bars/shell.qml"
// spawn-sh-at-startup "qs -p ~/.config/quickshell/lang_switch/shell.qml"
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'"
spawn-sh-at-startup "awww-daemon"
spawn-sh-at-startup "awww img --transition-step 15 ~/.config/wallpapers/secluded-grove-pixel-dark.png"

// These are the default values:
blur {
    // off
    passes 3
    offset 3
    noise 0.001
    saturation 1
}

clipboard {
    disable-primary
}
