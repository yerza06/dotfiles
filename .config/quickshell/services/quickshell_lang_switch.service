[Unit]
Description=Quickshell language switch notification
Documentation=file://%h/.config/quickshell/lang_switch/README.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/qs -c lang_switch
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s

[Install]
WantedBy=graphical-session.target
